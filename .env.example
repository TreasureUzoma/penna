DB_URL= # you can get yours from neon
REDIS_URL= # you can get yours from upstash redis

# generate urs from https://auth-secret-gen.vercel.app/
ENCRYPTION_KEY=
JWT_REFRESH_SECRET=
JWT_ACCESS_SECRET=

# you can update urs
DOCS_SITE=http://localhost:3006
DASHBOARD_SITE=http://localhost:3001
API_URL=http://localhost:3005
WEB_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000


#  get urs from coogle cloud console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# get urs from github developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# root url all apps are served from
APP_URL=http://localhost:3000

# AWS SES Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
NEWSLETTER_DOMAIN=newsletter.penna.dev
# Sender for system/transactional email (subscriber-limit warnings, etc).
# Must be a verified SES identity.
SYSTEM_EMAIL_FROM=notifications@penna.dev
# ARN of the SNS topic SES publishes bounce/complaint notifications to.
# See apps/server/services/mail/README.md for the one-time setup. Bounce/
# complaint handling is disabled (fails closed) until this is set.
SES_NOTIFICATIONS_TOPIC_ARN=

# Unsubscribe secret for email links
UNSUBSCRIBE_SECRET=

# Paddle Configuration (https://paddle.com)
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox # or production
# Dashboard > Developer Tools > Notifications > (your webhook destination) > secret key
# Webhooks are rejected outright if this isn't set — see apps/server/services/paddle.ts
PADDLE_WEBHOOK_SECRET=
# Dashboard > Catalog > Prices — checkout for a plan fails with a clear error if missing
PADDLE_PRICE_ID_PROFESSIONAL=
PADDLE_PRICE_ID_BUSINESS=
# Paddle > Developer Tools > Authentication > client-side tokens. Safe to
# expose (NEXT_PUBLIC_) — powers Paddle.js on apps/dashboard's billing page,
# which opens the actual checkout for a transaction created server-side.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox # or production — must match PADDLE_ENVIRONMENT
# Groq API key for external-API newsletter-send content moderation (spam/
# phishing/scam detection). Optional — if unset, moderation is skipped and
# sends go through unchecked. See apps/server/services/moderation.ts
GROQ_API_KEY=
